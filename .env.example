# Required when querying the existing Gemini-indexed collection.
GEMINI_API_KEY=
# A low-cost model used to reject unrelated questions before RAG operations.
GEMINI_SCOPE_MODEL=gemini-2.0-flash
# The existing generator and judge use Groq. GENERATOR_API_KEY and JUDGE_API_KEY
# are supported deployment aliases; set GROQ_API_KEY when using one shared Groq key.
GROQ_API_KEY=
GENERATOR_API_KEY=
JUDGE_API_KEY=

RAG_API_BASE_URL=http://localhost:8000
RAG_PIPELINE_CONFIG=config/pipeline_gemini.json
MAX_IMAGE_BYTES=5242880
ALLOWED_IMAGE_MIME_TYPES=image/jpeg,image/png
GENERATOR_TIMEOUT_SECONDS=30
JUDGE_TIMEOUT_SECONDS=15
CORS_ALLOWED_ORIGINS=http://localhost:8501
